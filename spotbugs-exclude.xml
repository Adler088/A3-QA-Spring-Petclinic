<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions of spring-petclinic-rest (tickets PQT-5 and PQT-8).

  Policy
  ======
  * Only structural false positives are excluded. Every rule below is scoped by package/class AND by bug
    pattern, and states why the "fix" would be wrong for this code base.
  * Real findings are fixed in the code instead: defensive copies of User.roles (EI_EXPOSE_REP/2),
    thread-safe CallMonitoringAspect (IS2_INCONSISTENT_SYNC, AT_*), null-safe JdbcPetRepositoryImpl
    (NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE), static Roles constants (SS_SHOULD_BE_STATIC), lambdas in
    JdbcVetRepositoryImpl (SIC_INNER_SHOULD_BE_STATIC_ANON), locale independent Owner.getPet (DM_CONVERT_CASE)
    and the final BindingErrorsResponse (MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR).
  * The build runs `spotbugs:check` in the `verify` phase (see pom.xml); any new finding fails the build.
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!--
      1. Code generated by openapi-generator-maven-plugin from src/main/resources/openapi.yml
         (target/generated-sources/openapi). The DTOs are plain JavaBeans for Jackson and the API interfaces /
         ApiUtil come from the generator templates; they are regenerated on every build, so source changes are
         impossible and defensive copies would only add allocations to every (de)serialization.
    -->
    <Match>
        <Or>
            <Package name="org.springframework.samples.petclinic.rest.dto"/>
            <Package name="org.springframework.samples.petclinic.rest.api"/>
        </Or>
    </Match>

    <!--
      2. Constructor injection of Spring singletons (EI_EXPOSE_REP2 on <init>). Controllers, services and
         repositories receive other singleton beans (ClinicService, repositories, mappers, JdbcTemplate) that are
         shared on purpose; they cannot be copied and are stored in final fields.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Method name="&lt;init&gt;"/>
        <Or>
            <Package name="~org\.springframework\.samples\.petclinic\.rest\.controller(\..*)?"/>
            <Package name="org.springframework.samples.petclinic.service"/>
            <Package name="~org\.springframework\.samples\.petclinic\.repository(\..*)?"/>
        </Or>
    </Match>

    <!--
      3. JPA associations (@ManyToOne) between entities. Hibernate relies on the identity of the referenced
         entity (persistence context, cascades, dirty checking) and MapStruct/Jackson navigate the same graph;
         returning or storing a copy would detach it. Collections of entities ARE protected (Owner.getPets,
         Pet.getVisits, Vet.getSpecialties and User.getRoles return read-only views).
    -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Or>
            <And>
                <Class name="org.springframework.samples.petclinic.model.Pet"/>
                <Or>
                    <Field name="owner"/>
                    <Field name="type"/>
                </Or>
            </And>
            <And>
                <Class name="org.springframework.samples.petclinic.model.Visit"/>
                <Field name="pet"/>
            </And>
            <And>
                <Class name="org.springframework.samples.petclinic.model.Role"/>
                <Field name="user"/>
            </And>
        </Or>
    </Match>

    <!--
      4. Spring Security API: HttpSecurity#build() and the AuthenticationManagerBuilder configurers declare
         "throws Exception", so the configuration methods must declare it too.
    -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
        <Package name="org.springframework.samples.petclinic.security"/>
    </Match>
</FindBugsFilter>
